# Copier vers .env et remplir (ne jamais committer .env)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Migrations CLI : pas de service_role — utiliser `npx supabase login` + `db:link` + `db:push`
# Mot de passe DB demandé interactivement au link (Settings → Database)

# --- Build APK (EAS) ---
# 1) cd apps/mobile
# 2) npm run eas:login
# 3) npm run eas:init          → crée le projectId Expo
# 4) Déclarer les variables sur EAS (cloud) :
#      npx eas-cli env:create --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxx.supabase.co" --environment preview --visibility plaintext
#      npx eas-cli env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "eyJ..." --environment preview --visibility sensitive
#    (répéter pour development / production si besoin)
# 5) npm run build:apk         → profil preview = APK installable
# 6) npm run build:aab         → profil production = AAB Play Store
