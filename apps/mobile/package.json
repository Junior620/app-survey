{
  "name": "@appsurvey/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-lan.ps1",
    "start:tunnel": "npx cross-env EXPO_NO_ADB=1 expo start --tunnel --clear",
    "start:no-adb": "npx cross-env EXPO_NO_ADB=1 expo start --tunnel --clear",
    "start:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/start-lan.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "db:login": "powershell -NoProfile -Command \"Set-Location ../..; npx supabase login\"",
    "db:link": "powershell -NoProfile -Command \"Set-Location ../..; npx supabase link --project-ref tsttdhoecetcouywjjsf\"",
    "db:push": "powershell -NoProfile -Command \"Set-Location ../..; npx supabase db push\"",
    "db:status": "powershell -NoProfile -Command \"Set-Location ../..; npx supabase migration list\""
  },
  "dependencies": {
    "@appsurvey/clmrs-engine": "file:../../packages/clmrs-engine",
    "@appsurvey/shared": "file:../../packages/shared",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^3.3.4",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-hook-form": "^7.51.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.4",
    "cross-env": "^7.0.3",
    "typescript": "~6.0.3"
  }
}
