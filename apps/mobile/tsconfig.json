{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@appsurvey/clmrs-engine": [
        "../../packages/clmrs-engine/src/index.ts"
      ],
      "@appsurvey/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "react-native-paper": [
        "./node_modules/react-native-paper"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "src/survey/surveyEngine.selftest.ts",
    "src/survey/consentPolicy.test.ts",
    "src/survey/annual/exploitationAgricole.test.ts",
    "src/survey/annual/annualInputs.test.ts",
    "src/survey/annual/annualCommercialisation.test.ts",
    "src/survey/annual/annualAgriculturalPractices.test.ts",
    "src/survey/annual/annualOtherAgriculturalActivities.test.ts",
    "src/survey/household/householdSurvey.test.ts",
    "node_modules"
  ]
}
